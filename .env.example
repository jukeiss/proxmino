# DeepSeek API (platform.deepseek.com)
# DEEPSEEK_API_KEY=

# Copy to .env and fill in only what you use. Never commit .env.
# Cloud providers are also off until you enable "Cloud providers" in Settings.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Web search (official APIs; you need your own account and must follow each provider's terms)
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Email (send_email tool; every send needs your approval)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=an app password, not your normal password
# SMTP_FROM=you@example.com

# X (Reply Desk "Post reply" and the post_x tool; every post needs your approval)
# From an X developer app with read and write permission. Check X's current API limits and automation rules.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
